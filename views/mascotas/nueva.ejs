<section>
    <h1>Nueva mascota</h1>
  
    <% if (error) { %>
      <p role="alert"><%= error %></p>
    <% } %>
  
    <form action="/mascotas" method="post">
  
      <div>
        <label for="nombre">Nombre</label>
        <input
          type="text"
          id="nombre"
          name="nombre"
          value="<%= valores.nombre || '' %>"
        >
      </div>
  
      <div>
        <label for="especie">Especie</label>
        <input
          type="text"
          id="especie"
          name="especie"
          value="<%= valores.especie || '' %>"
        >
      </div>
  
      <div>
        <label for="edad">Edad</label>
        <input
          type="number"
          id="edad"
          name="edad"
          min="0"
          value="<%= valores.edad || '' %>"
        >
      </div>
  
      <div>
        <label for="estado">Estado</label>
        <select id="estado" name="estado">
          <option value="">Seleccionar estado</option>
  
          <option value="En adopción"
            <%= valores.estado === "En adopción" ? "selected" : "" %>>
            En adopción
          </option>
  
          <option value="Reservada"
            <%= valores.estado === "Reservada" ? "selected" : "" %>>
            Reservada
          </option>
  
          <option value="Adoptada"
            <%= valores.estado === "Adoptada" ? "selected" : "" %>>
            Adoptada
          </option>
        </select>
      </div>
  
      <div>
        <label for="descripcion">Descripción</label>
        <textarea
          id="descripcion"
          name="descripcion"
        ><%= valores.descripcion || '' %></textarea>
      </div>
  
      <button type="submit">Agregar mascota</button>
  
    </form>
  </section>